{
  "_": "구멍(슬롯) 명세 — 사람이 읽는 판은 docs/slots.md. 이 파일은 템플릿이 자동 연결할 때 쓴다.",
  "_naming": "구멍 이름은 Figma 변형 축을 그대로 쓴다: {component}/{axis}/{axis}",
  "button": {
    "slot": "button/{variant}/{size}",
    "component": "Button",
    "axes": {
      "variant": [
        "primary",
        "default",
        "ai",
        "sub",
        "gray",
        "black",
        "delete",
        "ghost",
        "blackGhost",
        "deleteGhost"
      ],
      "size": [
        64,
        54,
        48,
        40,
        32,
        24
      ]
    },
    "children": "버튼",
    "flags": [
      "disabled",
      "loading",
      "fullWidth"
    ],
    "nodes": [
      "leftIcon",
      "rightIcon"
    ]
  },
  "input": {
    "slot": "input/{status}",
    "component": "InputField",
    "statusFromProps": {
      "default": {},
      "done": {
        "defaultValue": "Text"
      },
      "error": {
        "defaultValue": "Text",
        "error": "Error text"
      }
    },
    "_focus": "상호작용으로 결정 — prop 없음",
    "flags": [
      "revealToggle",
      "fullWidth",
      "disabled"
    ],
    "nodes": [
      "leftIcon"
    ],
    "props": {
      "label": "title",
      "placeholder": "placholder"
    }
  },
  "toggle": {
    "slot": "toggle/{state}",
    "component": "Toggle",
    "axes": {
      "state": [
        "off",
        "on"
      ]
    },
    "stateProp": "checked",
    "variantProps": {
      "labelled": {
        "label": "Text"
      }
    },
    "flags": [
      "disabled"
    ]
  },
  "checkbox": {
    "slot": "checkbox/{state}",
    "component": "Checkbox",
    "axes": {
      "state": [
        "unchecked",
        "checked",
        "indeterminate"
      ],
      "tone": [
        "brand",
        "ai"
      ]
    },
    "flags": [
      "disabled"
    ],
    "props": {
      "label": "Text"
    }
  },
  "radio": {
    "slot": "radio/{state}",
    "component": "Radio",
    "axes": {
      "state": [
        "default",
        "checked"
      ],
      "tone": [
        "brand",
        "ai"
      ]
    },
    "flags": [
      "disabled"
    ],
    "props": {
      "label": "Text",
      "name": "group",
      "value": "a"
    }
  },
  "tab": {
    "slot": "tab/{variant}",
    "component": "Tabs",
    "axes": {
      "variant": [
        "primary",
        "secondary"
      ]
    },
    "_scope": "구멍 하나 = 탭 묶음 전체",
    "props": {
      "items": [
        {
          "value": "a",
          "label": "Text"
        },
        {
          "value": "b",
          "label": "Text"
        },
        {
          "value": "c",
          "label": "Text"
        }
      ]
    },
    "flags": [
      "fill"
    ]
  },
  "segment": {
    "slot": "segment/{variant}",
    "component": "SegmentControl",
    "axes": {
      "variant": [
        "pill",
        "filled",
        "outlined"
      ]
    },
    "_figmaNames": {
      "pill": "solid-round",
      "filled": "Primary",
      "outlined": "secondary"
    },
    "_rule": "선택해도 항목 폭이 변하지 않아야 한다",
    "props": {
      "items": [
        {
          "value": "a",
          "label": "Text",
          "count": "num"
        },
        {
          "value": "b",
          "label": "Text",
          "count": "num"
        }
      ]
    }
  },
  "select": {
    "slot": "select/{size}",
    "component": "Select",
    "axes": {
      "size": [
        "lg",
        "md",
        "sm"
      ]
    },
    "_warning": "md·sm 은 Figma 가 아니라 PDS 문서 사이트 출처 — 확인 필요",
    "props": {
      "options": [
        {
          "value": "a",
          "label": "Text"
        }
      ]
    }
  },
  "menu-item": {
    "slot": "menu-item/{state}",
    "component": "MenuItem",
    "axes": {
      "state": [
        "default",
        "selected"
      ]
    },
    "flags": [
      "hasSubmenu",
      "hideCheck",
      "disabled"
    ],
    "props": {
      "label": "Text"
    },
    "container": {
      "component": "Menu",
      "slot": "menu",
      "props": {
        "width": 152
      }
    }
  },
  "badge": {
    "slot": "badge/{state}",
    "component": "Badge",
    "axes": {
      "state": [
        "default",
        "selected"
      ]
    },
    "stateProp": "selected",
    "children": "Text"
  },
  "credit": {
    "slot": "credit/{state}",
    "component": "Credit",
    "axes": {
      "state": [
        "available",
        "unavailable"
      ]
    },
    "stateProp": "available",
    "props": {
      "value": 10
    },
    "nodes": [
      "icon"
    ]
  },
  "table": {
    "slot": "table",
    "component": "Table",
    "flags": [
      "columnDividers"
    ],
    "props": {
      "columns": "[{ header: '제목', cell }]",
      "rows": "[{ … '내용' }]"
    }
  },
  "tooltip": {
    "slot": "tooltip/{placement}",
    "component": "Tooltip",
    "axes": {
      "placement": [
        "top",
        "bottom",
        "left",
        "right",
        "none"
      ]
    },
    "_wrapper": "구멍 안에 트리거가 들어간다",
    "props": {
      "content": "Text"
    },
    "flags": [
      "open"
    ],
    "_missing": "가장자리 자동 반전 미구현"
  },
  "toast": {
    "slot": "toast/{type}",
    "component": "Toast",
    "axes": {
      "type": [
        "default",
        "success",
        "error"
      ],
      "placement": [
        "top",
        "bottom"
      ]
    },
    "_overlay": "화면 가장자리 고정 — 견본은 '열기' 버튼 권장",
    "props": {
      "message": "성공 메세지를 전달하는 토스트 팝업입니다."
    }
  },
  "popup": {
    "slot": "popup/{case}",
    "component": "Popup",
    "cases": {
      "one": {
        "primaryAction": true,
        "showCloseButton": false
      },
      "one-x": {
        "primaryAction": true,
        "onClose": true
      },
      "one-dont": {
        "primaryAction": true,
        "onClose": true,
        "dontShowAgain": true
      },
      "two": {
        "primaryAction": true,
        "secondaryAction": true
      },
      "two-dont": {
        "primaryAction": true,
        "secondaryAction": true,
        "dontShowAgain": true
      }
    },
    "props": {
      "title": "Title",
      "body": "Body",
      "actionLabel": "버튼"
    },
    "_overlay": "화면 차단 — 견본은 '열기' 버튼 권장"
  },
  "dim": {
    "slot": "dim/{state}",
    "component": "Dim",
    "axes": {
      "state": [
        "loading",
        "plain"
      ]
    },
    "stateProp": "loading",
    "_rule": "부모를 덮는다 — 구멍이 크기를 가져야 보인다",
    "flags": [
      "fullscreen"
    ]
  },
  "radio-group": {
    "slot": "radio-group",
    "component": "RadioGroup",
    "_scope": "구멍 하나 = 라디오 묶음 전체. name·선택 상태를 자식에게 내려준다",
    "props": {
      "name": "group",
      "defaultValue": "a"
    },
    "children": "<Radio value=\"a\" label=\"Text\" /> …",
    "flags": [
      "inline",
      "disabled"
    ]
  },
  "download-icon": {
    "slot": "download-icon",
    "component": "DownloadIcon",
    "_scope": "문서 예제가 아이콘 자리를 보여줄 때 쓰는 최소 세트 — PDS 아이콘 시스템 전체가 아니다",
    "props": {
      "size": "1.25em (기본, 부모를 따름)"
    }
  },
  "menu-divider": {
    "slot": "menu-divider",
    "component": "MenuDivider",
    "_scope": "메뉴 항목 그룹 구분 — 필요할 때만 넣는다"
  },
  "icon-button": {
    "slot": "icon-button/{size}",
    "component": "IconButton",
    "axes": {
      "size": [
        40,
        32,
        28
      ]
    },
    "_rule": "반드시 tooltip 을 동반한다. 파괴적 액션에는 쓰지 않는다",
    "nodes": [
      "icon"
    ]
  },
  "user-icon": {
    "slot": "user-icon",
    "component": "UserIcon",
    "_scope": "문서 예제가 아이콘 자리를 보여줄 때 쓰는 최소 세트 — PDS 아이콘 시스템 전체가 아니다",
    "props": {
      "size": "1.25em (기본, 부모를 따름)"
    }
  },
  "toaster": {
    "slot": "toaster",
    "component": "Toaster",
    "_scope": "toast() 첫 호출 때 자동 마운트된다 — 직접 심을 필요 없다. 위치를 직접 잡고 싶을 때만 배치"
  },
  "progress-circle": {
    "slot": "progress-circle/{size}",
    "component": "ProgressCircle",
    "axes": {
      "size": [
        18,
        24,
        32,
        48
      ]
    },
    "_rule": "트랙 없이 호 하나가 돈다 — 색은 color 로 바꾼다(딤 위 static/white, 버튼 안 currentColor)"
  },
  "progress-bar": {
    "slot": "progress-bar/{type}",
    "component": "ProgressBar",
    "axes": {
      "type": [
        "indeterminate",
        "determinate"
      ]
    },
    "_rule": "너비는 영역에 맞춘다 — 구멍이 폭을 가져야 보인다. determinate 는 value(0~100)"
  },
  "skeleton": {
    "slot": "skeleton/{shape}",
    "component": "Skeleton",
    "axes": {
      "shape": [
        "rect",
        "circle",
        "text"
      ]
    },
    "_rule": "실제 콘텐츠와 같은 위치·크기로 둔다. width/height 로 맞춘다"
  }
}
